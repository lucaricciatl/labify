# ─── Frontend ──────────────────────────────────────────────────
# VITE_API_URL=http://localhost:3000

# ─── API / Backend ──────────────────────────────────────────────
API_PORT=3000
DATABASE_PATH=./data/labify.db

# JWT secret — CHANGE THIS IN PRODUCTION
JWT_SECRET=replace-with-a-long-random-string

# App URL used in verification emails (must point to the frontend)
APP_URL=http://localhost:5173

# ─── Email ───────────────────────────────────────────────────────
# Option A: Use a well-known service (gmail, outlook365, sendgrid, etc.)
# EMAIL_SERVICE=gmail
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Option B: Custom SMTP server
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@yourlab.com

# If neither EMAIL_SERVICE nor SMTP_HOST is set, verification links
# are printed to the server console instead.

# ─── Docker Compose ─────────────────────────────────────────────
LISTEN=0.0.0.0
HOST=0.0.0.0
PORT=8080
API_PORT=3000
