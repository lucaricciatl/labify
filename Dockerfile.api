# syntax=docker/dockerfile:1
FROM node:22-alpine

# Install build tools required by better-sqlite3 native bindings
RUN apk add --no-cache python3 make g++ sqlite-dev

WORKDIR /app

COPY package*.json ./
# Force rebuild when package.json changes — do NOT use --ignore-scripts
RUN npm ci

COPY tsconfig.server.json ./
COPY server/ ./server/

ENV API_PORT=3000
ENV DATABASE_PATH=/data/labify.db

EXPOSE 3000

CMD ["npx", "tsx", "server/index.ts"]
